<%- include('partials-head') %>

<section class="page-hero compact">
  <div class="container">
    <span class="eyebrow light">FOR EXPERTS</span>
    <h1>전문가 등록</h1>
    <p>TA · AA · DBA · SWA · SA · PM · IT컨설턴트 경력자만 등록받습니다. 등록은 무료이며, 프로필은 매칭 제안 시 동의 후에만 기업에 공유됩니다.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="form-layout">
      <aside class="form-aside">
        <h2>등록하면 좋은 점</h2>
        <ul class="check-list">
          <li>공고를 뒤지지 않아도 맞는 프로젝트를 먼저 제안받습니다.</li>
          <li>프로필은 비공개로 보관되며 담당자만 열람합니다.</li>
          <li>표준계약서 기반으로 계약·정산을 지원합니다.</li>
          <li>재계약·소개가 이어질수록 수수료가 낮아집니다.</li>
        </ul>
        <p class="muted">직군 정의가 궁금하시면 <a href="/#roles">전문 직군 안내</a>를 참고하세요.</p>
      </aside>

      <div class="form-card">
        <% if (success) { %>
          <div class="success-banner">등록이 완료되었습니다. 검토 후 담당자가 연락드립니다.</div>
        <% } %>
        <form method="POST" action="/register">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="two-col">
            <div><label for="v-name">이름 *</label><input id="v-name" type="text" name="name" required maxlength="100"></div>
            <div>
              <label for="v-role">직군 *</label>
              <select id="v-role" name="role" required>
                <option value="">선택</option>
                <% roles.forEach(function(r){ %><option value="<%= r %>"><%= r %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="two-col">
            <div><label for="v-years">경력연차</label><input id="v-years" type="number" name="career_years" min="0" max="60"></div>
            <div>
              <label for="v-grade">등급</label>
              <select id="v-grade" name="grade">
                <option value="">선택</option>
                <% grades.forEach(function(g){ %><option value="<%= g %>"><%= g %></option><% }) %>
              </select>
            </div>
          </div>
          <label for="v-expertise">주요 전문분야 / 기술스택</label>
          <input id="v-expertise" type="text" name="expertise" maxlength="500" placeholder="예: 금융권 차세대 시스템 아키텍처, MSA 설계">

          <div class="two-col">
            <div><label for="v-phone">연락처 *</label><input id="v-phone" type="tel" name="phone" required maxlength="50"></div>
            <div><label for="v-email">이메일</label><input id="v-email" type="email" name="email" maxlength="200"></div>
          </div>
          <div class="two-col">
            <div><label for="v-avail">가용 시점</label><input id="v-avail" type="date" name="available_date"></div>
            <div>
              <label for="v-work">근무 형태</label>
              <select id="v-work" name="work_type">
                <option value="상주">상주 가능</option>
                <option value="재택">재택 가능</option>
                <option value="협의">협의 가능</option>
              </select>
            </div>
          </div>
          <label for="v-rate">희망 단가</label>
          <input id="v-rate" type="text" name="rate" maxlength="100" placeholder="예: 월 800만원">

          <label for="v-ref">최근 프로젝트 레퍼런스</label>
          <textarea id="v-ref" name="reference" rows="5" maxlength="4000" placeholder="최근 수행한 프로젝트를 간단히 적어주세요 (발주처/역할/기간)"></textarea>

          <div class="check-row">
            <input type="checkbox" name="consent" id="consent" required>
            <label for="consent">개인정보를 인력풀 등록 및 프로젝트 매칭 목적으로 활용하는 데 동의합니다. (필수) <a href="/privacy">개인정보처리방침</a></label>
          </div>

          <button class="btn primary large" type="submit">등록하기</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials-foot') %>
