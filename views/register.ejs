<%- include('partials-head') %>
<div class="container">
  <div class="card">
    <h1>전문가 등록</h1>
    <p class="lead">TA / AA / DBA / SWA / SA / PM / IT컨설턴트 전문 인력만 등록받습니다.</p>

    <% if (success) { %>
      <div class="success-banner">등록이 완료되었습니다. 검토 후 담당자가 연락드립니다.</div>
    <% } %>

    <form method="POST" action="/register">
      <div class="two-col">
        <div>
          <label>이름 *</label>
          <input type="text" name="name" required>
        </div>
        <div>
          <label>직군 *</label>
          <select name="role" required>
            <option value="">선택</option>
            <% roles.forEach(function(r){ %><option value="<%= r %>"><%= r %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="two-col">
        <div>
          <label>경력연차</label>
          <input type="number" name="career_years" min="0">
        </div>
        <div>
          <label>등급</label>
          <select name="grade">
            <option value="">선택</option>
            <% grades.forEach(function(g){ %><option value="<%= g %>"><%= g %></option><% }) %>
          </select>
        </div>
      </div>
      <label>주요 전문분야 / 기술스택</label>
      <input type="text" name="expertise" placeholder="예: 금융권 차세대 시스템 아키텍처, MSA 설계">

      <div class="two-col">
        <div>
          <label>연락처 *</label>
          <input type="tel" name="phone" required>
        </div>
        <div>
          <label>이메일</label>
          <input type="email" name="email">
        </div>
      </div>
      <div class="two-col">
        <div>
          <label>가용 시점</label>
          <input type="date" name="available_date">
        </div>
        <div>
          <label>근무 형태</label>
          <select name="work_type">
            <option value="상주">상주 가능</option>
            <option value="재택">재택 가능</option>
            <option value="협의">협의 가능</option>
          </select>
        </div>
      </div>
      <label>희망 단가</label>
      <input type="text" name="rate" placeholder="예: 월 800만원">

      <label>최근 프로젝트 레퍼런스</label>
      <textarea name="reference" placeholder="최근 수행한 프로젝트를 간단히 적어주세요"></textarea>

      <div class="check-row">
        <input type="checkbox" name="consent" id="consent" required>
        <label for="consent" style="margin:0;">개인정보를 인력풀 등록 및 프로젝트 매칭 목적으로 활용하는 데 동의합니다. (필수)</label>
      </div>

      <div style="margin-top:20px;">
        <button class="btn" type="submit">등록하기</button>
      </div>
    </form>
  </div>
</div>
<%- include('partials-foot') %>
