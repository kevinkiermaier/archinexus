<%- include('partials-head') %>

<section class="page-hero compact">
  <div class="container">
    <span class="eyebrow light">CONTACT</span>
    <h1>문의하기</h1>
    <p>인력 의뢰, 전문가 등록, 제휴 제안 등 어떤 내용이든 남겨주세요. 담당자가 확인 후 연락드립니다.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-side">
        <h2>직접 연락하기</h2>
        <% if (company.email) { %>
          <div class="contact-item"><span>이메일</span><a href="mailto:<%= company.email %>"><%= company.email %></a></div>
        <% } %>
        <% if (company.phone) { %>
          <div class="contact-item"><span>전화</span><a href="tel:<%= company.phone.replace(/[^0-9+]/g, '') %>"><%= company.phone %></a></div>
        <% } %>
        <% if (company.address) { %>
          <div class="contact-item"><span>주소</span><p><%= company.address %></p></div>
        <% } %>
        <% if (!company.email && !company.phone && !company.address) { %>
          <p class="muted">아래 양식으로 문의를 남겨주시면 담당자가 연락드립니다.</p>
        <% } %>
        <div class="contact-shortcuts">
          <p>바로 진행하시려면</p>
          <a class="btn primary" href="/request">기업 의뢰 양식</a>
          <a class="btn dark" href="/register">전문가 등록 양식</a>
        </div>
      </div>

      <div class="form-card">
        <% if (success) { %>
          <div class="success-banner">문의가 접수되었습니다. 담당자가 확인 후 빠르게 연락드리겠습니다.</div>
        <% } %>
        <form method="POST" action="/contact">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label for="c-type">문의 유형</label>
          <select id="c-type" name="type">
            <% types.forEach(function(t){ %><option value="<%= t %>"><%= t %></option><% }) %>
          </select>
          <div class="two-col">
            <div><label for="c-name">이름 *</label><input id="c-name" type="text" name="name" required maxlength="100"></div>
            <div><label for="c-company">회사 / 소속</label><input id="c-company" type="text" name="company" maxlength="200"></div>
          </div>
          <div class="two-col">
            <div><label for="c-email">이메일 *</label><input id="c-email" type="email" name="email" required maxlength="200"></div>
            <div><label for="c-phone">연락처</label><input id="c-phone" type="tel" name="phone" maxlength="50"></div>
          </div>
          <label for="c-message">문의 내용 *</label>
          <textarea id="c-message" name="message" required rows="6" maxlength="4000" placeholder="프로젝트 개요, 필요 직군·기간, 또는 문의하실 내용을 자유롭게 적어주세요."></textarea>
          <p class="form-note">남겨주신 정보는 문의 응대 목적으로만 사용되며, <a href="/privacy">개인정보처리방침</a>에 따라 처리됩니다.</p>
          <button class="btn primary large" type="submit">문의 보내기</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials-foot') %>
