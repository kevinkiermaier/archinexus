<%- include('partials-head') %>
<div class="container">
  <div class="card">
    <h1>기업 의뢰하기</h1>
    <p class="lead">필요한 직군과 프로젝트 개요를 알려주시면, 검증된 전문가를 확인 후 연락드립니다.</p>

    <% if (success) { %>
      <div class="success-banner">의뢰가 접수되었습니다. 담당자가 확인 후 빠르게 연락드리겠습니다.</div>
    <% } %>

    <form method="POST" action="/request">
      <div class="two-col">
        <div><label>회사명 / 발주처 *</label><input type="text" name="client" required></div>
        <div><label>프로젝트명</label><input type="text" name="name" placeholder="예: OO시스템 고도화 프로젝트"></div>
      </div>

      <label>필요 직군 (여러 개 선택 가능) *</label>
      <select name="needed_roles" multiple size="7" required>
        <% roles.forEach(function(r){ %><option value="<%= r %>"><%= r %></option><% }) %>
      </select>

      <div class="two-col">
        <div><label>필요 인원</label><input type="number" name="headcount" min="1"></div>
        <div><label>예산/단가</label><input type="text" name="budget" placeholder="예: 월 900만원"></div>
      </div>
      <div class="two-col">
        <div><label>희망 착수일</label><input type="date" name="start_date"></div>
        <div><label>담당자 연락처 *</label><input type="text" name="contact_info" placeholder="이름 / 연락처" required></div>
      </div>

      <label>프로젝트 개요</label>
      <textarea name="note" placeholder="프로젝트 배경, 기간, 근무 형태(상주/재택) 등을 자유롭게 적어주세요"></textarea>

      <div style="margin-top:20px;">
        <button class="btn" type="submit">의뢰 접수하기</button>
      </div>
    </form>
  </div>
</div>
<%- include('partials-foot') %>
